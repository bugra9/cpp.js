{
    "name": "@cpp.js/package-proj-wasi",
    "version": "2.0.0-beta.36",
    "nativeVersion": "9.8.1",
    "description": "WASI build of the precompiled PROJ coordinate-transformation library, built with cpp.js. Use it together with the main package @cpp.js/package-proj.",
    "homepage": "https://github.com/bugra9/cpp.js/tree/main/packages/cppjs-package-proj#readme",
    "repository": "https://github.com/bugra9/cpp.js.git",
    "type": "module",
    "license": "MIT",
    "keywords": [
        "proj",
        "libproj",
        "projection",
        "gis",
        "cpp.js",
        "cpp.js-package",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "cppjs build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .cppjs dist",
        "prepublishOnly": "cppjs build -p wasi"
    },
    "dependencies": {
        "@cpp.js/package-proj": "workspace:^",
        "@cpp.js/package-tiff-wasi": "workspace:^",
        "@cpp.js/package-sqlite3-wasi": "workspace:^"
    },
    "devDependencies": {
        "cpp.js": "workspace:^"
    }
}
