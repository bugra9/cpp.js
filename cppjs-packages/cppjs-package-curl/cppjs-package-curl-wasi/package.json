{
    "name": "@cpp.js/package-curl-wasi",
    "version": "2.0.0-beta.36",
    "nativeVersion": "8.21.0",
    "description": "WASI build of the precompiled libcurl (CURL) library, built with cpp.js. Use it together with the main package @cpp.js/package-curl.",
    "homepage": "https://github.com/bugra9/cpp.js/tree/main/packages/cppjs-package-curl#readme",
    "repository": "https://github.com/bugra9/cpp.js.git",
    "type": "module",
    "license": "curl",
    "keywords": [
        "curl",
        "libcurl",
        "http",
        "networking",
        "cpp.js",
        "cpp.js-package",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "cppjs build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .cppjs dist",
        "prepublishOnly": "cppjs build -p wasi"
    },
    "dependencies": {
        "@cpp.js/package-curl": "workspace:^",
        "@cpp.js/package-openssl-wasi": "workspace:^"
    },
    "devDependencies": {
        "cpp.js": "workspace:^"
    }
}
