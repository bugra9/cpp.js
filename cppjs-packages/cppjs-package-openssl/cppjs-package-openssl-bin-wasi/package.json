    "keywords": [
        "openssl",
        "cli",
        "cpp.js",
        "cpp.js-package",
        "webassembly",
        "wasi",
        "wasmtime"
    ],
    "scripts": {
        "build": "cppjs build -p wasi -b release",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .cppjs dist",
        "prepublishOnly": "cppjs build -p wasi -b release"
    },
    "dependencies": {
