{
    "name": "@cpp.js/package-tiff-wasi",
    "version": "2.0.0-beta.37",
    "nativeVersion": "4.7.2",
    "description": "WASI build of the precompiled TIFF (libtiff) image library, built with cpp.js. Use it together with the main package @cpp.js/package-tiff.",
    "homepage": "https://github.com/bugra9/cpp.js/tree/main/packages/cppjs-package-tiff#readme",
    "repository": "https://github.com/bugra9/cpp.js.git",
    "type": "module",
    "license": "libtiff",
    "keywords": [
        "tiff",
        "libtiff",
        "image",
        "cpp.js",
        "cpp.js-package",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "cppjs build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .cppjs dist",
        "prepublishOnly": "cppjs build -p wasi"
    },
    "dependencies": {
        "@cpp.js/package-tiff": "workspace:^",
        "@cpp.js/package-zlib-wasi": "workspace:^"
    },
    "devDependencies": {
        "cpp.js": "workspace:^"
    }
}
