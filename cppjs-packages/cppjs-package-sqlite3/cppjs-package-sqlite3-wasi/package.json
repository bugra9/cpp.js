{
    "name": "@cpp.js/package-sqlite3-wasi",
    "version": "2.0.0-beta.33",
    "nativeVersion": "3.53.4",
    "description": "WASI build of the precompiled SQLite3 database engine, built with cpp.js. Use it together with the main package @cpp.js/package-sqlite3.",
    "homepage": "https://github.com/bugra9/cpp.js/tree/main/packages/cppjs-package-sqlite3#readme",
    "repository": "https://github.com/bugra9/cpp.js.git",
    "license": "blessing",
    "type": "module",
    "scripts": {
        "build": "cppjs build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .cppjs dist",
        "prepublishOnly": "cppjs build -p wasi"
    },
    "dependencies": {
        "@cpp.js/package-sqlite3": "workspace:^"
    },
    "devDependencies": {
        "cpp.js": "workspace:^"
    },
    "keywords": [
        "sqlite",
        "sqlite3",
        "libsqlite3",
        "database",
        "sql",
        "cpp.js",
        "cpp.js-package",
        "webassembly",
        "wasi"
    ]
}
