{
    "name": "@cpp.js/package-iconv-wasi",
    "version": "2.0.0-beta.36",
    "nativeVersion": "1.19",
    "description": "WASI build of the precompiled libiconv character-encoding library, built with cpp.js. Use it together with the main package @cpp.js/package-iconv.",
    "homepage": "https://github.com/bugra9/cpp.js/tree/main/packages/cppjs-package-iconv#readme",
    "repository": "https://github.com/bugra9/cpp.js.git",
    "type": "module",
    "license": "LGPL-2.1-or-later",
    "keywords": [
        "iconv",
        "libiconv",
        "charset",
        "encoding",
        "cpp.js",
        "cpp.js-package",
        "webassembly",
        "wasi"
    ],
    "scripts": {
        "build": "cppjs build -p wasi",
        "e2e": "node e2e/run.mjs",
        "clear": "rm -rf .cppjs dist",
        "prepublishOnly": "cppjs build -p wasi"
    },
    "dependencies": {
        "@cpp.js/package-iconv": "workspace:^"
    },
    "devDependencies": {
        "cpp.js": "workspace:^"
    }
}
