# Vite fingerprints everything under /assets, so those URLs can never go stale.
# The fonts alone are 225 kB; without this they would be revalidated on every visit.
# index.html and favicon.svg are left out on purpose - they keep their names across deploys.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The playground runs visitors' code here, in a frame with an opaque origin: no network, no forms, no other
# scripts, and a sandbox even when the page is opened on its own. The hash is the page's one inline script.
# Cloudflare Pages redirects sandbox.html to /playground/sandbox and serves the page there, so both paths carry it.
/playground/sandbox.html
  Content-Security-Policy: sandbox allow-scripts; default-src 'none'; script-src 'sha256-6ueMHMAPndT2H8rXtZmr1FBIEmzhoKkXFAMOPhgfA+I=' blob: 'unsafe-eval' 'wasm-unsafe-eval'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Cache-Control: no-cache

/playground/sandbox
  Content-Security-Policy: sandbox allow-scripts; default-src 'none'; script-src 'sha256-6ueMHMAPndT2H8rXtZmr1FBIEmzhoKkXFAMOPhgfA+I=' blob: 'unsafe-eval' 'wasm-unsafe-eval'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'
  Cache-Control: no-cache
